; LumaBridge configuration: %LOCALAPPDATA%\LumaBridge\LumaBridge.ini
; The app edits this file for you (Settings / Devices pages); editing by hand is optional.
; A LumaBridge.ini next to a game-folder DLL overrides it for that DLL only.
; Every key is optional; the values shown are the defaults.

[Logitech]
; Forward every LogiLed call to the real Logitech DLL so Logitech devices keep working.
Passthrough=1
; Real SDK DLL. Empty = auto-detect: registry (HKLM ServerBinary), then
; C:\Program Files\LGHUB\sdk_legacy_led_x64.dll, then the old LGS path.
; The install script fills this in when it redirects the registry machine-wide.
RealDllPath=

[Aura]
Enabled=1
; How to reach the hardware:
;   usb = the motherboard's Aura USB controller, directly (default)
;   sdk = ASUS's Aura SDK (reports no devices on current Armoury Crate versions and can
;         crash in one of ASUS's device plug-ins; only for older setups)
Backend=usb
; Upper bound on Aura updates per second. Aura's Apply() is slow-ish; 30 is plenty.
MaxUpdateHz=30
; Which Aura device types to drive: all, or a comma list of
; motherboard, motherboard_ledstrip, vga, dram, keyboard, mouse, headset, chassis, ...
; or raw hex codes (0x00090000). Run aura-test.exe list to see yours.
DeviceTypes=all
; Skip devices whose name contains any of these (comma separated, case-insensitive).
ExcludeNames=
; Devices switched off on the app's Devices page (exact names, '|' separated).
DisabledDevices=
; Let game DLLs load the Aura SDK themselves when the LumaBridge app isn't running.
; Off by default: a crash inside ASUS's Aura library would take the game down with it.
DirectFromGames=0
; Hand lighting back to Armoury Crate when the game shuts the SDK down.
ReleaseControlOnShutdown=1

[Color]
; Calibration applied to everything sent to Aura (percent). Aura LEDs tend to run
; bluer/brighter than Logitech's; lower GainB / Brightness to match.
Brightness=100
GainR=100
GainG=100
GainB=100
; >1 darkens mid-tones (e.g. 2.2 when games send sRGB-ish values that look washed out).
Gamma=1.0

[Mirror]
; How a per-key frame (LogiLed bitmap, Chroma keyboard grid) becomes one ambient color:
; average   = mean of the lit keys
; brightest = the single brightest key (punchier for effects that light a few keys)
BitmapMode=average

[Chroma]
; Which Chroma device class drives Aura: auto, keyboard, chromalink, headset, mousepad,
; keypad, mouse. auto = keyboard if the game sends keyboard effects, else Chroma Link, ...
AmbientSource=auto
; Answer "connected" to every QueryDevice() so games light up devices you don't own.
ReportDevicesConnected=1

[GameSense]
; Built-in SteelSeries GameSense server (LumaBridge.exe).
Enabled=1
; Loopback port; a free one is picked if this is taken.
Port=49713
; Empty = %ProgramData%\SteelSeries\SteelSeries Engine 3\coreProps.json
CorePropsPath=
; With SteelSeries GG installed, pass every GameSense request on to GG as well, so GG
; (SteelSeries devices, Moments auto-clips) keeps working.
ForwardToGG=1

[App]
; auto (games drive the lights) | manual
Mode=auto
ManualColor=#008CFF
; static | breathing | strobe
ManualEffect=static
; cycles / flashes per second
ManualSpeed=0.5
; What Auto mode shows between games: armourycrate | manual
WhenIdle=armourycrate
StartMinimized=1

[Log]
; debug | info | warn | error | off
Level=info
; Empty = %LOCALAPPDATA%\LumaBridge\lumabridge.log (the app and each emulator write
; lumabridge-app.log, lumabridge-chroma.log, lumabridge-corsair.log, ... next to it)
File=
